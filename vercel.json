{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/[...route].ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/d/(.*)",
      "destination": "/api/[...route]"
    },
    {
      "source": "/sd/(.*)",
      "destination": "/api/[...route]"
    },
    {
      "source": "/p/(.*)",
      "destination": "/api/[...route]"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...route]"
    },
    {
      "source": "/((?!api/|d/|sd/|p/).*)",
      "destination": "/index.html"
    }
  ]
}
