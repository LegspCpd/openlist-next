# =============================================================================
# OpenList Next · 环境变量（模板）
# =============================================================================
#
# 用途：Cloudflare「Deploy to Cloudflare」按钮会读取本文件（或 .dev.vars.example），
#       识别需要用户填写的变量，并在部署页生成对应输入项。
#
# 重要：按钮会为**每一个未注释的变量**生成一个输入框。所以本文件默认只留两个 ——
#       必填的 JWT_SECRET，和选填的 ADMIN_PASS。其余全部注释掉：用到哪个功能，
#       再去掉行首的 `#`。注释掉的行不会被读取，本地 `cp` 成 `.env` 后同样不生效。
#
# 为什么值留空：本文件会提交到公开仓库，绝不能包含真实密钥。
#   部署时用户填入的值会成为该 Worker 的 Secret，后续更新不会被覆盖。
#
# 本地开发：复制为 `.env`（已被 .gitignore 忽略）并填入真实值。
#
# 本项目新增的外部存储（Neon / Turso / Supabase / MySQL 网关 / Upstash / R2 / S3）
#   见：./docs/EXTERNAL_STORAGE.md
# 各变量是干什么的、要不要填：见 README 的「环境变量」章。
# =============================================================================

# ── 必填 ────────────────────────────────────────────────────────────────────

# JWT 签名密钥，同时用于字段加密（网盘凭据、2FA 密钥）与定时任务鉴权。
# 要求 >=16 字符；推荐用 `openssl rand -hex 32` 生成。
JWT_SECRET=

# ── 选填 ────────────────────────────────────────────────────────────────────

# 跳过安装向导，直接用此密码初始化 admin 账号。留空则由浏览器向导设置。
ADMIN_PASS=

# ── 以下都用不到就别管（取消注释即生效）───────────────────────────────────────

# CORS 允许来源白名单，逗号分隔，如 https://yourdomain.com
# 留空表示仅允许同源请求。
#ALLOW_URLS=

# MySQL 连接串（DB_DRIVER=mysql，仅 Node 容器走 TCP 直连时必填）
# 如 mysql://user:pass@host:3306/db
# 也可改用 MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASS / MYSQL_NAME 分项。
#MYSQL_URLS=

# ── 外部存储（推荐，任意平台通用）──────────────────────────────────────────
#
# 最省事的用法：只填 DATABASE_URL，保持 DB_DRIVER=auto，驱动会自动识别。
# 厂商专属变量优先级高于 DATABASE_URL，需要额外凭据时再单独填。
# 详细配置与网关参考实现见 docs/EXTERNAL_STORAGE.md

# 通用连接串：
#   postgres://…@ep-xxx.neon.tech/…   → Neon（HTTP，边缘可用，推荐）
#   libsql://db.turso.io              → Turso
#   https://xxx.supabase.co           → Supabase / PostgREST
#   mysql://…                         → MySQL（配合 MYSQL_HTTP_URL 网关）
#DATABASE_URL=

# Neon Serverless Postgres
#NEON_DATABASE_URL=

# Turso / libSQL
#TURSO_DATABASE_URL=
#TURSO_AUTH_TOKEN=

# Supabase / PostgREST（需先在 SQL Editor 建 kv 表，见文档）
#SUPABASE_URL=
#SUPABASE_KEY=

# 自建 Postgres 系 HTTP 网关
#PG_HTTP_URL=
#PG_HTTP_TOKEN=

# MySQL / MariaDB 的 HTTP 转发网关（边缘访问外部 MySQL 的唯一途径）
#MYSQL_HTTP_URL=
#MYSQL_HTTP_TOKEN=

# Upstash Redis
#UPSTASH_REDIS_REST_URL=
#UPSTASH_REDIS_REST_TOKEN=

# S3 兼容对象存储（R2 / MinIO / Backblaze B2 等）
#S3_BUCKET=
#S3_REGION=
#S3_ENDPOINT=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=

# EdgeOne Node 云函数专用：KV 代理地址（DB_DRIVER=kv 且运行在 EdgeOne Node 云函数时必填）。
# EdgeOne 的 KV 绑定不会注入 Node 云函数，必须经同部署的 Edge Functions 代理访问，
# 此处填写部署的 origin，如 https://your-project.edgeone.app
# 留空时自动使用当前请求的 origin（同一部署自调用）；跨域或本地调试才需显式设置。
#EO_KV_URLS=

# Cloudflare KV REST API 凭据（DB_DRIVER=cfkv 时三项均必填）。
# 账户 ID
#CF_ACCOUNT=
# KV namespace ID
#CF_KV_UUID=
# 具有 KV 读写权限的 API Token
#CF_API_KEY=
